# ==============================================================================
# Smart Placement Management System (SPMS) — Environment Variables Template
# Copy this file to .env and configure values for your deployment or local run.
# DO NOT COMMIT REAL PASSWORDS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0 / Managed Cloud MySQL)
# ------------------------------------------------------------------------------
# Set DB_URL directly if provided by your host (Railway / Aiven):
# DB_URL=jdbc:mysql://your-db-host.aivencloud.com:12345/defaultdb?sslmode=require
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_placement_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_placeholder
DB_SSL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# Application & JWT Authentication Secrets
# (JWT Secret must be at least 256 bits / 32 bytes for HMAC-SHA256)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_placeholder_0000000000000000
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# CORS & Storage Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FILE_UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Feature Toggles
# ------------------------------------------------------------------------------
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
